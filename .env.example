# Copy to .env and adjust values: cp .env.example .env

# PostgreSQL
POSTGRES_DB=project_tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
# Host used when running Django outside Docker. Docker Compose overrides this to "db".
DB_HOST=localhost
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Host ports (change if already in use on your machine)
BACKEND_PORT=8000
POSTGRES_PORT=5432
